{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniserve.local/schemas/generation-runtime-candidate-plan.schema.json",
  "title": "Generation runtime candidate plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boundary",
    "development_ref",
    "affected_scope",
    "checks",
    "comparators",
    "artifact_root",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "boundary": {"type": "string", "pattern": "^S(?:0[0-9]|1[0-9]|2[0-2])$"},
    "development_ref": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"},
    "affected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "impact_classes"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "impact_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "documentation",
              "protocol",
              "profile",
              "evaluator",
              "frontend",
              "scheduler",
              "worker",
              "model",
              "kernel",
              "dependency",
              "executable",
              "benchmark"
            ]
          }
        },
        "critical_path_digests": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "comparators": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_commit", "artifact_root"],
        "properties": {
          "source_commit": {"$ref": "#/$defs/commit"},
          "measurement_commit": {"$ref": "#/$defs/commit"},
          "artifact_root": {"$ref": "#/$defs/repository_path"},
          "manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifact_root": {"type": "string", "pattern": "^artifacts/qualification/generation_runtime/[A-Za-z0-9._/{}/-]+$"},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast_forward", "update_ref"],
      "properties": {
        "fast_forward": {"const": true},
        "update_ref": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gate", "order", "command", "timeout_s", "artifact_role"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "gate": {"enum": ["C0", "C1", "C2", "C3", "C4", "C5", "P0", "P1", "P2", "P3", "P4", "P5"]},
        "order": {"type": "integer", "minimum": 0},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        },
        "timeout_s": {"type": "integer", "minimum": 1},
        "artifact_role": {"enum": ["none", "diagnostic", "canonical"]},
        "artifact_path": {"$ref": "#/$defs/repository_path"},
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["points"],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind"],
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                  "kind": {"enum": ["benchmark", "verification", "oracle", "stress", "reference"]},
                  "qualification_gate": {"enum": ["P1", "P2", "P3", "P4"]},
                  "profile": {"type": "string", "minLength": 1},
                  "group": {"type": "string", "minLength": 1},
                  "point": {"type": "string", "minLength": 1},
                  "load_case_set": {"type": "string", "minLength": 1},
                  "load_case_id": {"type": "string", "minLength": 1},
                  "execution_depth": {"type": ["integer", "string"], "minimum": 1},
                  "topology": {"type": "string", "minLength": 1},
                  "role": {"enum": ["candidate", "reference", "oracle"]},
                  "artifact_path": {"type": "string", "minLength": 1},
                  "comparator_paths": {
                    "type": "object",
                    "additionalProperties": {"type": "string", "minLength": 1}
                  },
                  "required_success_count": {"type": "integer", "minimum": 1},
                  "metrics": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "objective", "path"],
                      "properties": {
                        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                        "objective": {"enum": ["maximize", "minimize"]},
                        "path": {
                          "type": "array",
                          "minItems": 1,
                          "items": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"artifact_role": {"const": "canonical"}}},
          "then": {"required": ["artifact_path"]}
        }
      ]
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/{}/-]+$"}
  }
}
