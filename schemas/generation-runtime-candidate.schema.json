{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniserve.local/schemas/generation-runtime-candidate.schema.json",
  "title": "Generation runtime candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "boundary",
    "affected_scope",
    "checks",
    "comparators",
    "artifact_root",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "commit", "development_ref"],
      "properties": {
        "parent": {"$ref": "#/$defs/commit"},
        "commit": {"$ref": "#/$defs/commit"},
        "development_ref": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"}
      }
    },
    "boundary": {"type": "string", "pattern": "^S(?:0[0-9]|1[0-9]|2[0-2])$"},
    "affected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "impact_classes"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "impact_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "documentation",
              "protocol",
              "profile",
              "evaluator",
              "frontend",
              "scheduler",
              "worker",
              "model",
              "kernel",
              "dependency",
              "executable",
              "benchmark"
            ]
          }
        },
        "critical_path_digests": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gate", "order", "command", "timeout_s", "artifact_role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "gate": {"enum": ["C0", "C1", "C2", "C3", "C4", "C5", "P0", "P1", "P2", "P3", "P4", "P5"]},
          "order": {"type": "integer", "minimum": 0},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          },
          "timeout_s": {"type": "integer", "minimum": 1},
          "artifact_role": {"enum": ["none", "diagnostic", "canonical"]},
          "artifact_path": {"$ref": "#/$defs/repository_path"}
        },
        "allOf": [
          {
            "if": {"properties": {"artifact_role": {"const": "canonical"}}},
            "then": {"required": ["artifact_path"]}
          }
        ]
      }
    },
    "comparators": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_commit", "artifact_root"],
        "properties": {
          "source_commit": {"$ref": "#/$defs/commit"},
          "artifact_root": {"$ref": "#/$defs/repository_path"},
          "manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifact_root": {"type": "string", "pattern": "^artifacts/qualification/generation_runtime/[A-Za-z0-9._/-]+$"},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast_forward", "update_ref"],
      "properties": {
        "fast_forward": {"const": true},
        "update_ref": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}
  }
}
