{
  "artifact_root": "artifacts",
  "python": ".venv/bin/python",
  "server_bin": "target/debug/uniserve",
  "servers": {
    "qwen3-32b": {
      "model": "/home/hal-ysun/models/Qwen3-32B",
      "served_model_name": "Qwen3-32B",
      "host": "127.0.0.1",
      "port": 18081,
      "cuda_visible_devices": "0",
      "serve_args": []
    },
    "sensenova-u1-single": {
      "model": "/home/hal-ysun/models/SenseNova-U1-8B-MoT-Interleaved-local",
      "served_model_name": "SenseNova-U1",
      "host": "127.0.0.1",
      "port": 18082,
      "cuda_visible_devices": "0",
      "serve_args": [
        "--kv-token-capacity",
        "65536",
        "--max-num-seqs",
        "1",
        "--max-batch",
        "4",
        "--max-num-batched-tokens",
        "4096"
      ]
    },
    "sensenova-u1-disagg": {
      "extends": "sensenova-u1-single",
      "cuda_visible_devices": "0,1",
      "serve_args": [
        "--workers",
        "und:1,gen:1",
        "--transfer",
        "und->gen=cuda_ipc",
        "--kv-token-capacity",
        "65536",
        "--max-num-seqs",
        "1",
        "--max-batch",
        "4",
        "--max-num-batched-tokens",
        "1024"
      ]
    },
    "sensenova-u1-tp4": {
      "extends": "sensenova-u1-single",
      "cuda_visible_devices": "0,1,2,3",
      "serve_args": [
        "--kv-token-capacity",
        "65536",
        "--max-num-seqs",
        "1",
        "--max-batch",
        "4",
        "--max-num-batched-tokens",
        "4096",
        "--worker-ranks",
        "4"
      ]
    },
    "sensenova-u1-tp4-graph": {
      "extends": "sensenova-u1-tp4",
      "env": {
        "UNISERVE_DENOISE_STEP_GRAPH": "1",
        "UNISERVE_DECODE_TOKEN_BURST": "8"
      },
      "description": "sensenova-u1-tp4 plus per-image denoise-step CUDA graphs and decode bursts. Net win at TP4 (CPU-launch-bound); leave the step graph off at TP1."
    },
    "sensenova-u1-perf": {
      "extends": "sensenova-u1-single",
      "env": {
        "UNISERVE_DECODE_TOKEN_BURST": "8"
      }
    },
    "sensenova-u1-teacache": {
      "extends": "sensenova-u1-perf",
      "env": {
        "UNISERVE_DENOISE_RESIDUAL_CACHE": "1"
      },
      "description": "sensenova-u1-perf plus the opt-in TeaCache denoise residual cache (threshold defaults to 0.2). Off in gates: default-path outputs are the guarded identities."
    },
    "bagel-single": {
      "model": "/home/hal-ysun/models/BAGEL-7B-MoT",
      "served_model_name": "BAGEL",
      "port": 18083,
      "cuda_visible_devices": "0",
      "env": {
        "UNISERVE_DECODE_TOKEN_BURST": "8"
      },
      "serve_args": [
        "--kv-token-capacity",
        "65536",
        "--max-num-seqs",
        "1",
        "--max-batch",
        "4",
        "--max-num-batched-tokens",
        "4096"
      ],
      "host": "127.0.0.1"
    },
    "sensenova-omni": {
      "served_model_name": "/home/hal-ysun/models/SenseNova-U1-8B-MoT-Interleaved-local",
      "host": "127.0.0.1",
      "port": 8091,
      "cuda_visible_devices": "1",
      "command": [
        "/home/hal-ysun/omni-bench-venv/bin/vllm",
        "serve",
        "/home/hal-ysun/models/SenseNova-U1-8B-MoT-Interleaved-local",
        "--omni",
        "--host",
        "127.0.0.1",
        "--port",
        "8091"
      ],
      "description": "vLLM-Omni serving SenseNova-U1 (single-stage diffusion pipeline) for same-workload comparison; slow cold start (several minutes)."
    },
    "bagel-omni": {
      "served_model_name": "/home/hal-ysun/models/BAGEL-7B-MoT",
      "host": "127.0.0.1",
      "port": 8092,
      "cuda_visible_devices": "1",
      "env": {
        "VLLM_OMNI_USE_QUACK_FP8": "0"
      },
      "command": [
        "/home/hal-ysun/omni-bench-venv/bin/vllm",
        "serve",
        "/home/hal-ysun/models/BAGEL-7B-MoT",
        "--omni",
        "--attention-config",
        "{\"backend\": \"TRITON_ATTN\"}",
        "--mm-encoder-attn-backend",
        "TORCH_SDPA",
        "--host",
        "127.0.0.1",
        "--port",
        "8092"
      ],
      "description": "vLLM-Omni serving BAGEL (two-stage Thinker+DiT). Triton/SDPA attention overrides dodge its broken FlashAttention-CuTe build on this aarch64 stack."
    }
  },
  "workloads": {
    "sensenova-travel-interleave-4x": {
      "type": "verify",
      "server": "sensenova-u1-single",
      "output_dir": "sensenova-travel-interleave-4x",
      "payload": {
        "mode": "interleave",
        "prompt": "Generate a travel guide covering Sonoma, Sequoia, Tahoe, and the Golden Gate.",
        "max_tokens": 4096,
        "temperature": 0,
        "image": {
          "resolution": "16:9",
          "width": 2048,
          "height": 1152,
          "steps": 50,
          "max_images": 4,
          "retain_images": true
        }
      },
      "expect_images": 4,
      "expect_image_width": 2048,
      "expect_image_height": 1152,
      "expect_image_steps": 50,
      "timeout_s": 900,
      "description": "The guarded tour-guide case: one interleave request ('travel guide covering Sonoma, Sequoia, Tahoe, and the Golden Gate', temp 0, max 4 images 2048x1152@50 steps). Expected: the model autonomously weaves narrative text with exactly 4 generated images (one per destination) in a single SSE stream \u2014 4x(image_begin + 50 image_step + image_done), 0 errors, ~2800 text tokens at TP1, and every image readable/coherent/non-collapsed/non-duplicated (inspect saved PNGs)."
    },
    "qwen3-sharegpt-stress": {
      "type": "perf",
      "server": "qwen3-32b",
      "task": "text",
      "args": [
        "--dataset",
        "sharegpt",
        "--num-prompts",
        "200",
        "--request-rate",
        "16",
        "--max-tokens",
        "4096",
        "--seed",
        "42"
      ],
      "expect_metrics": {
        "completed": {
          "min": 200
        }
      },
      "description": "Text-serving stress through the shared harness: 200 ShareGPT prompts at 16 req/s against Qwen3-32B; expects all 200 requests completed."
    },
    "sensenova-t2i-seed42": {
      "type": "verify",
      "server": "sensenova-u1-single",
      "payload": {
        "mode": "image",
        "prompt": "A red bicycle leaning against a weathered brick wall, golden hour light",
        "seed": 42,
        "image": {
          "width": 2048,
          "height": 1152,
          "steps": 50
        }
      },
      "expect_images": 1,
      "expect_image_steps": 50,
      "expect_image_width": 2048,
      "expect_image_height": 1152,
      "description": "Pure text-to-image gate on the native API (mode=image): seed-42 bicycle prompt at 2048x1152, exactly 50 denoise steps, exactly one PNG of exact size. Guards the prefill->denoise->commit chain and the resolution-bucket policy."
    },
    "sensenova-i2t-house": {
      "type": "verify",
      "server": "sensenova-u1-single",
      "payload": {
        "mode": "understand",
        "prompt": "Describe this image in detail.",
        "max_tokens": 128,
        "temperature": 0
      },
      "input_image_synthetic": {
        "seed": 0,
        "width": 960,
        "height": 640
      },
      "expect_images": 0,
      "expect_min_text_tokens": 32,
      "description": "Image-understanding gate (mode=understand): a deterministic synthetic scene (red house, brown roof, yellow sun, blue sky, green ground) is injected as input_image_b64; the model must stream >=32 tokens of description at temp 0 and finish cleanly. Guards the encode->prefill->decode chain (marker-in-prompt patch injection)."
    },
    "bagel-t2i-seed42": {
      "type": "verify",
      "server": "bagel-single",
      "payload": {
        "mode": "image",
        "prompt": "A red bicycle leaning against a weathered brick wall, golden hour light",
        "seed": 42,
        "image": {
          "width": 1024,
          "height": 1024,
          "steps": 50
        }
      },
      "expect_images": 1,
      "expect_image_steps": 50,
      "expect_image_width": 1024,
      "expect_image_height": 1024,
      "description": "BAGEL pure t2i gate (mode=image): seed-42 bicycle prompt at 1024x1024, exactly 50 steps, one exact-size PNG. Guards BAGEL's paged-extend prefill, batched CFG denoise, and VAE-decode commit on the unified runtime."
    },
    "bagel-i2t-house": {
      "type": "verify",
      "server": "bagel-single",
      "payload": {
        "mode": "understand",
        "prompt": "Describe this image in detail.",
        "max_tokens": 128,
        "temperature": 0
      },
      "input_image_synthetic": {
        "seed": 0,
        "width": 960,
        "height": 640
      },
      "expect_images": 0,
      "expect_min_text_tokens": 32,
      "description": "BAGEL understanding gate over the same synthetic scene: >=32 tokens at temp 0, clean finish. Guards the dual-encode (VAE+ViT) ingest and the graphed/burst decode."
    },
    "sensenova-t2i-perf": {
      "type": "perf",
      "server": "sensenova-u1-perf",
      "task": "t2i",
      "args": [
        "--dataset",
        "trace",
        "--dataset-path",
        "uniserve_e2e/data/t2i_prompts.jsonl",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--steps",
        "50",
        "--seed",
        "42",
        "--width",
        "2048",
        "--height",
        "1152"
      ],
      "expect_metrics": {
        "image_latency_ms.mean": {
          "max": 8000
        }
      },
      "description": "Perf tripwire through the shared harness: 4 prompts from the committed t2i set, closed-loop c=1, warmup 1. Bound trips only if the path regresses to a known-slow regime. Healthy ~4.8-5.6s/image."
    },
    "sensenova-i2t-perf": {
      "type": "perf",
      "server": "sensenova-u1-perf",
      "task": "i2t",
      "args": [
        "--dataset",
        "synthetic-images",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--max-tokens",
        "256",
        "--temperature",
        "0",
        "--seed",
        "42",
        "--i2t-wire",
        "native"
      ],
      "expect_metrics": {
        "output_throughput": {
          "min": 120
        },
        "mean_itl_ms": {
          "max": 9
        }
      },
      "description": "Perf tripwire: 4 synthetic-image descriptions, greedy, 256 tokens. Floor trips on regression to eager per-token decode. Healthy ~160-170 tok/s, ITL ~5ms."
    },
    "bagel-t2i-perf": {
      "type": "perf",
      "server": "bagel-single",
      "task": "t2i",
      "args": [
        "--dataset",
        "trace",
        "--dataset-path",
        "uniserve_e2e/data/t2i_prompts.jsonl",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--steps",
        "50",
        "--seed",
        "42",
        "--width",
        "1024",
        "--height",
        "1024"
      ],
      "expect_metrics": {
        "image_latency_ms.mean": {
          "max": 10000
        }
      },
      "description": "Perf tripwire through the shared harness: 4 prompts from the committed t2i set, closed-loop c=1, warmup 1. Bound trips only if the path regresses to a known-slow regime. Healthy ~6.6s/image (eager pre-unification path was 15.4s)."
    },
    "bagel-i2t-perf": {
      "type": "perf",
      "server": "bagel-single",
      "task": "i2t",
      "args": [
        "--dataset",
        "synthetic-images",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--max-tokens",
        "256",
        "--temperature",
        "0",
        "--seed",
        "42",
        "--i2t-wire",
        "native"
      ],
      "expect_metrics": {
        "output_throughput": {
          "min": 100
        },
        "mean_itl_ms": {
          "max": 9
        }
      },
      "description": "Perf tripwire: 4 synthetic-image descriptions, greedy, 256 tokens. Floor trips on regression to eager per-token decode. Healthy ~155-165 tok/s (eager path was 15.6 tok/s)."
    },
    "sensenova-t2i-perf-omni": {
      "type": "perf",
      "server": "sensenova-omni",
      "task": "t2i",
      "args": [
        "--dataset",
        "trace",
        "--dataset-path",
        "uniserve_e2e/data/t2i_prompts.jsonl",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--steps",
        "50",
        "--seed",
        "42",
        "--width",
        "2048",
        "--height",
        "1152"
      ],
      "description": "vLLM-Omni comparison point: byte-for-byte the same workload as sensenova-t2i-perf (same prompts/steps/sizes/seed/concurrency), measured through the same harness. No bounds \u2014 a measurement, not a gate."
    },
    "sensenova-i2t-perf-omni": {
      "type": "perf",
      "server": "sensenova-omni",
      "task": "i2t",
      "args": [
        "--dataset",
        "synthetic-images",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--max-tokens",
        "256",
        "--temperature",
        "0",
        "--seed",
        "42",
        "--i2t-wire",
        "openai_chat"
      ],
      "description": "vLLM-Omni comparison point: byte-for-byte the same workload as sensenova-i2t-perf (same prompts/steps/sizes/seed/concurrency), measured through the same harness. No bounds \u2014 a measurement, not a gate."
    },
    "bagel-t2i-perf-omni": {
      "type": "perf",
      "server": "bagel-omni",
      "task": "t2i",
      "args": [
        "--dataset",
        "trace",
        "--dataset-path",
        "uniserve_e2e/data/t2i_prompts.jsonl",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--steps",
        "50",
        "--seed",
        "42",
        "--width",
        "1024",
        "--height",
        "1024"
      ],
      "description": "vLLM-Omni comparison point: byte-for-byte the same workload as bagel-t2i-perf (same prompts/steps/sizes/seed/concurrency), measured through the same harness. No bounds \u2014 a measurement, not a gate."
    },
    "bagel-i2t-perf-omni": {
      "type": "perf",
      "server": "bagel-omni",
      "task": "i2t",
      "args": [
        "--dataset",
        "synthetic-images",
        "--num-prompts",
        "4",
        "--max-concurrency",
        "1",
        "--warmup-requests",
        "1",
        "--max-tokens",
        "256",
        "--temperature",
        "0",
        "--seed",
        "42",
        "--i2t-wire",
        "openai_chat"
      ],
      "description": "vLLM-Omni comparison point: byte-for-byte the same workload as bagel-i2t-perf (same prompts/steps/sizes/seed/concurrency), measured through the same harness. No bounds \u2014 a measurement, not a gate."
    }
  },
  "suites": {
    "qwen3-32b": [
      "qwen3-sharegpt-stress"
    ],
