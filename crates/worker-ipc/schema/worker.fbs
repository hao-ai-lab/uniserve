namespace uniserve.ipc;

// Closed forward-mode tag for one operation. Declaration order is the
// canonical index in IPC and worker selection.
enum ForwardMode : ubyte {
  TokenExtend,
  TokenDecode,
  TokenVerify,
  EncodeVision,
  EncodeLatent,
  TransferProduct,
  TransferKvPublish,
  TransferKvInstall,
  MediaPrepare,
  MediaDenoise,
  Materialize,
  MediaReconstruct
}

enum ReconstructionKind : ubyte { Video, Audio }
enum MediaProfileId : ubyte { MinimaxH3T2va }

enum Domain : ubyte { Prefill, Decode, Flow }
enum AttentionRegime : ubyte { None, Causal, Bidirectional, Hybrid }
enum SamplingOwnership : ubyte { DesignatedRank, DeterministicSharded }
enum WorkerRole : ubyte { Full, Encoder, Prefill, Decode, Und, Gen }

enum ProductKind : ubyte {
  Token,
  Logprob,
  VisionFeature,
  LatentFeature,
  Kv,
  Latent,
  Artifact,
  Completion,
  SamplingState,
  SelectedPoint
}

enum StorageClass : ubyte {
  DeviceTensor,
  RequestRelay,
  PagedKv,
  LatentArena,
  HostStaging,
  PinnedOutput
}

enum DType : ubyte { U8, U16, U32, I32, I64, F16, BF16, F32 }

enum OpStatus : ubyte { Ok, Predicated, Error }

enum ErrorCode : ubyte {
  InvalidOperation,
  ResourceExhausted,
  ComputeError,
  Cancelled,
  Internal
}

enum DrawLayout : ubyte { TargetSampling, SpeculativeProposal, FlowNoise }

enum Disposition : ubyte { Publish, Retain, Discard }

enum CloseReason : ubyte { Completed, Cancelled, Error, Preempted }

// Administrative worker command channel (separate from request `Control`).
enum ReqKind : ubyte {
  GetInfo,
  Execute,
  PollCompletions,
  DropSession,
  Shutdown,
  ReleaseProducts,
  GetPressure
}

enum RespKind : ubyte { Info, Result, Ok, Error, Pressure }
enum ResourceClass : ubyte { KvBlock, EncoderOutput, ImageLatent }
enum KvGroupKind : ubyte { Full, SlidingWindow }

table U32List { items:[uint]; }
table TokenBias { token_id:uint; bias:float; }
table StringU64Pair { key:string; value:ulong; }

table SamplingParams {
  temperature:float;
  top_k:uint;
  top_p:float;
  ignore_eos:bool;
  seed:ulong = null;
  min_p:float;
  repetition_penalty:float = 1.0;
  frequency_penalty:float;
  presence_penalty:float;
  logit_bias:[TokenBias];
  min_tokens:ulong;
  n_logprobs:uint;
  bad_words_ids:[U32List];
  allowed_token_ids:[uint];
  return_logprobs:bool;
  return_prompt_logprobs:bool;
  n_prompt_logprobs:uint;
  logprob_token_ids:[uint];
  typical_p:float = 1.0;
  forced_token_ids:[uint];
}

table ImageParams {
  steps:ushort;
  cfg_text_scale:float;
  cfg_img_scale:float;
  cfg_renorm_type:string;
  cfg_renorm_min:float;
  cfg_interval_lo:float;
  cfg_interval_hi:float;
  timestep_shift:float = 1.0;
  height:uint;
  width:uint;
  seed:ulong = null;
  negative_prompt:string;
  max_images:ushort;
  image_prompts:[string];
  retain_images:bool = true;
}

table KvGroup {
  num_blocks:uint;
  kind:KvGroupKind;
  window:uint;
  sink:uint;
}

table RankInfo {
  tp_rank:uint;
  tp_size:uint = 1;
}

table ResourcePressure {
  class:ResourceClass;
  total:ulong;
  used:ulong;
  evictable:ulong;
  free:ulong;
}

table GraphBucket {
  decode_rows:uint;
  flow_rows:uint;
  height:uint;
  width:uint;
  cfg_branches:uint;
}

table WorkerInfo {
  worker_role:WorkerRole;
  block_size:uint;
  num_blocks:uint;
  num_layers:uint;
  num_kv_heads:uint;
  head_dim:uint;
  supported_work:[ForwardMode];
  latent_page_units:uint;
  num_latent_pages:uint;
  latent_width:uint;
  latent_dtype:string;
  latent_downsample:uint;
  bytes_per_token:ulong;
  max_vae_grid_tokens:uint;
  max_vit_grid_tokens:uint;
  max_latent_feature_bytes:ulong;
  max_vision_feature_bytes:ulong;
  commit_marker_tokens:uint;
  gen_rope_advance:uint;
  max_cfg_branches:uint;
  groups:[KvGroup];
  kv_dtype:string;
  model_dtype:string;
  rank:RankInfo;
  pipeline_depth:uint;
  encoder_cache_budget:uint;
  supported_controls:[ReqKind];
  max_batch_operations:uint;
  max_batch_tokens:uint;
  max_request_pool_size:uint;
  max_unresolved_window:uint = 1;
  incremental_kv_publication:bool;
  mixed_buckets:[GraphBucket];
  sampling_ownership:SamplingOwnership;
  resource_classes:[ResourceClass];
  model_name:string;
  weight_version:ulong;
}

// ---- Identities and the four operation records ----------------------------

table RequestKey {
  authority_id:ulong;
  session_id:ulong;
  epoch:ulong;
}

table PointFixed {
  point_index:uint;
}

table PointDevice {
  point_index:uint;
  selected_point:ProductRef;
}

union Point { PointFixed, PointDevice }

table VersionRef {
  request_key:RequestKey;
  producer_op_id:ulong;
  point:Point;
}

// One dimension of a bounded shape: a host-static extent when `device` is
// false, or the fixed maximum of the single device-actual axis when true.
table DimBound {
  device:bool;
  value:uint;
}

table ShapeBound { dims:[DimBound]; }

table PointRange {
  base_point:uint;
  max_points:uint;
}

table ProductRef {
  request_key:RequestKey;
  producer_op_id:ulong;
  output_index:ushort;
  generation:uint;
  kind:ProductKind;
  storage_class:StorageClass;
  dtype:DType;
  shape_bound:ShapeBound;
  point_range:PointRange;
}

table Bounds {
  max_points:uint;
  max_tokens:uint;
  max_kv_pages:uint;
  max_latent_bytes:ulong;
  max_completion_bytes:ulong;
  max_transfer_bytes:ulong;
}

table Rng {
  seed:ulong;
  semantic_index_base:ulong;
  draw_layout:DrawLayout;
}

table Operation {
  request_key:RequestKey;
  op_id:ulong;
  parent:VersionRef;
  work:ForwardMode;
  route:uint;
  domain:Domain;
  advances_state:bool;
  bounds:Bounds;
  inputs:[ProductRef];
  outputs:[ProductRef];
  predicate:ProductRef;
  rng:Rng;
  control_seq:ulong;
}

table BlockTable {
  request_pool_idx:uint;
  group_id:uint;
  page_ids:[uint];
  allocated_tokens:uint;
}

table CachePageAllocation {
  request_pool_idx:uint;
  group_id:uint;
  page_ids:[uint];
}

table RowGeometry {
  operation_index:uint;
  request_pool_index:uint;
  seq_len:uint;
  query_len:uint;
}

table LatentPlacement {
  request_key:RequestKey;
  op_id:ulong;
  page_table:[uint];
  latent_units:uint;
  height:uint;
  width:uint;
  start_step:uint;
  step_count:uint;
}

table ReconstructionPlacement {
  request_key:RequestKey;
  op_id:ulong;
  kind:ReconstructionKind;
  start_unit:uint;
  unit_count:uint;
}

table LogicalLengths {
  token_len:uint;
  kv_visible_len:uint;
  kv_computed_len:uint;
  latent_len:uint;
}

table TokenSpan {
  base:uint;
  len:uint;
}

table FinishFlags {
  eos:bool;
  length:bool;
  stop:bool;
}

table TimingCounters {
  queued_us:ulong;
  device_us:ulong;
  copy_us:ulong;
  host_us:ulong;
}

table MediaOutput {
  handle:string;
  bytes:ulong;
}

table ModelOutput {
  request_key:RequestKey;
  op_id:ulong;
  completion_slot_generation:uint;
  status:OpStatus;
  selected_point:uint;
  logical_lengths:LogicalLengths;
  token_span:TokenSpan;
  committed_tokens:[uint];
  finish_flags:FinishFlags;
  product_generations:[uint];
  error_code:ErrorCode = null;
  timing_counters:TimingCounters;
  media_output:MediaOutput;
}

table ControlCommit {
  request_key:RequestKey;
  control_seq:ulong;
  expected_parent:VersionRef;
  selected:VersionRef;
  public_event_limit:ulong;
  disposition:Disposition;
}

table ControlClose {
  request_key:RequestKey;
  control_seq:ulong;
  cutoff:VersionRef;
  reason:CloseReason;
}

table ControlRelease {
  request_key:RequestKey;
  op_id:ulong;
}

union Control { ControlCommit, ControlClose, ControlRelease }

table ControlEnvelope { control:Control; }

// ---- NewRequest framing (session establishment) ----------------------------

table UndAdmission {
  sampling:SamplingParams;
  negative_token_ids:[uint];
  finish_token_ids:[uint];
  initial_position:uint;
}

table GenAdmission { image:ImageParams; }

table MediaGeometry {
  frame_count:uint;
  video_reconstruction_units:uint;
  audio_latent_frames:uint;
  prompt_tokens:uint;
  denoise_steps:uint;
}

table MediaAdmission {
  prompt_token_ids:[uint];
  seed:ulong;
  profile:MediaProfileId;
  geometry:MediaGeometry;
}

table NewRequest {
  request_key:RequestKey;
  request_pool_idx:uint;
  und:UndAdmission;
  gen_admission:GenAdmission;
  media:MediaAdmission;
}

table BatchPartition {
  partition_id:uint;
  submission_group:uint;
  collective_seq:ulong;
  domain:Domain;
  route:uint;
  attention:AttentionRegime;
  shape_class:ulong;
  operations:[Operation];
  block_tables:[BlockTable];
  new_cache_pages:[CachePageAllocation];
  forward_rows:[RowGeometry];
  latent_placements:[LatentPlacement];
  reconstruction_placements:[ReconstructionPlacement];
}

table Batch {
  step_id:ulong;
  admissions:[NewRequest];
  partitions:[BatchPartition];
  controls:[ControlEnvelope];
  input_products:[ProductPayload];
}

// ---- Worker response payloads ---------------------------------------------

table RegistrationAck { visible:bool; }

// A resolved output-product value the worker delivers for host consumption:
// requested logprob blobs, materialized image bytes, and similar. The consumer
// interprets the bytes for its product kind.
table ProductPayload {
  product:ProductRef;
  bytes:[ubyte];
}

table PartitionCompletion {
  partition_id:uint;
  completions:[ModelOutput];
  products:[ProductPayload];
  registration:RegistrationAck;
  worker_exec_us:ulong = null;
  forward_stats:WorkerForwardStats;
}

table CompletionReport {
  step_id:ulong;
  partitions:[PartitionCompletion];
}

table WorkerForwardStats {
  mode_counts:[StringU64Pair];
  mode_tokens:[StringU64Pair];
  mode_us:[StringU64Pair];
  attention_launches:ulong;
  attention_us:ulong;
  attention_backend_counts:[StringU64Pair];
  cuda_graph_captures:ulong;
  cuda_graph_replays:ulong;
  cuda_graph_misses:ulong;
  cuda_graph_fallbacks:ulong;
  cuda_graph_unpadded_tokens:ulong;
  cuda_graph_padded_tokens:ulong;
  cuda_graph_runtime_mode_counts:[StringU64Pair];
  text_decode_token_relay_hits:ulong;
  text_decode_token_relay_misses:ulong;
  text_decode_position_relay_hits:ulong;
  text_decode_position_relay_misses:ulong;
  flashinfer_decode_plan_calls:ulong;
  flashinfer_decode_plan_reuses:ulong;
  flashinfer_decode_plan_rows:ulong;
  flashinfer_decode_plan_indices:ulong;
  flashinfer_decode_graph_plan_calls:ulong;
  flashinfer_decode_graph_plan_reuses:ulong;
  spec_verify_rows:ulong;
  spec_verify_draft_tokens:ulong;
  spec_verify_accepted_tokens:ulong;
  spec_verify_rejected_tokens:ulong;
  spec_verify_committed_tokens:ulong;
  spec_verify_path_counts:[StringU64Pair];
  component_us:[StringU64Pair];
}

table WorkerRequest {
  kind:ReqKind;
  call_id:ulong = null;
  batch:Batch;
  step_id:ulong = null;
  session_id:ulong = null;
  product_handles:[ulong];
}

table ErrorOperationIdentity {
  request_key:RequestKey;
  op_id:ulong;
}

table WorkerResponse {
  kind:RespKind;
  call_id:ulong = null;
  info:WorkerInfo;
  completion_report:CompletionReport;
  pressure:[ResourcePressure];
  message:string;
  code:string;
  retryable:bool = null;
  fatal:bool = null;
  phase:string;
  route:string;
  operations:[ErrorOperationIdentity];
}

root_type WorkerRequest;
