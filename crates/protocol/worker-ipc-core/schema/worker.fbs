namespace uniserve.wire;

// Protocol v3 uses the five closed semantic variants below.
enum OperationKind : ubyte { Sequence, Flow, Encode, Materialize, Transfer }
enum OperationType : ubyte {
  SequenceExtend,
  SequenceDecode,
  SequenceVerify,
  SequenceSample,
  Flow,
  EncodeVision,
  EncodeLatent,
  MaterializeImage,
  MaterializeFrame,
  TransferProduct,
  TransferKv
}
enum SequenceMode : ubyte { Extend, Decode, Verify, Sample }
enum TokenSource : ubyte { Wire, LastSampled }
enum EncodeKind : ubyte { Vision, Latent }
enum MaterializeKind : ubyte { Image, Frame }
enum TransferKind : ubyte { Product, Kv }

enum ReqKind : ubyte {
  GetCapabilities,
  Execute,
  DropSession,
  Shutdown,
  CopyKv,
  LoadAdapter,
  UnloadAdapter,
  ReleaseProducts,
  ResetPrefixCache,
  GetMetrics,
  GetPressure,
  SnapshotSession,
  RestoreSession
}

enum RespKind : ubyte { Capabilities, Result, Ok, Error, Metrics, Pressure, Snapshot }
enum AdapterMode : ubyte { None, EngineWide, PerRequest, MultiAdapter }
enum ResourceClass : ubyte { KvBlock, EncoderOutput, ImageLatent, Scratch, Adapter }
enum LeasePolicy : ubyte { PerRequest, Evictable, Pinned }
enum ResourceEventKind : ubyte { Issued, Released, Evicted, InvariantViolation }
enum KvGroupKind : ubyte { Full, SlidingWindow }

table U32List { items:[uint]; }
table U64List { items:[ulong]; }
table TokenBias { token_id:uint; bias:float; }
table TokenLogprob { token_id:uint; logprob:float; rank:uint; }
table PositionLogprobs { entries:[TokenLogprob]; }
table BlockPair { src:uint; dst:uint; }
table StringU64Pair { key:string; value:ulong; }

table SnapshotRef {
  session_id:ulong;
  epoch:ulong;
  version:ulong;
  digest:string;
  locator:string;
}

table SamplingParams {
  temperature:float;
  top_k:uint;
  top_p:float;
  ignore_eos:bool;
  seed:ulong = null;
  min_p:float;
  repetition_penalty:float = 1.0;
  frequency_penalty:float;
  presence_penalty:float;
  logit_bias:[TokenBias];
  min_tokens:ulong;
  n_logprobs:uint;
  bad_words_ids:[U32List];
  allowed_token_ids:[uint];
  return_logprobs:bool;
  return_prompt_logprobs:bool;
  n_prompt_logprobs:uint;
  logprob_token_ids:[uint];
}

table ImageParams {
  steps:ushort;
  cfg_text_scale:float;
  cfg_img_scale:float;
  cfg_renorm_type:string;
  cfg_renorm_min:float;
  cfg_interval_lo:float;
  cfg_interval_hi:float;
  timestep_shift:float = 1.0;
  height:uint;
  width:uint;
  seed:ulong = null;
  negative_prompt:string;
  max_images:ushort;
  image_prompts:[string];
  retain_images:bool = true;
}

table Guidance {
  branch_count:ubyte;
  text_scale:float;
  image_scale:float;
  renorm_type:string;
  renorm_min:float;
  interval_lo:float;
  interval_hi:float;
}

table KvGroupSpec {
  group_id:uint;
  block_offset:uint;
  num_blocks:uint;
  kind:KvGroupKind;
  window:uint;
  sink:uint;
}

table RankInfo {
  tp_rank:uint;
  tp_size:uint = 1;
  pp_rank:uint;
  pp_size:uint = 1;
  dp_rank:uint;
  dp_size:uint = 1;
}

table ExecutionConstraints { max_batch_operations:uint; }

table ResourcePressure {
  class:ResourceClass;
  total:ulong;
  used:ulong;
  evictable:ulong;
  free:ulong;
}

table EngineCaps {
  block_size:uint;
  num_blocks:uint;
  num_layers:uint;
  scratch_capacity_tokens:ulong;
  supported_operation_types:[OperationType];
  max_latent_size:uint;
  latent_downsample:uint;
  bytes_per_token:ulong;
  max_vae_grid_tokens:uint;
  max_vit_grid_tokens:uint;
  commit_marker_tokens:uint;
  gen_rope_advance:uint;
  max_cfg_branches:uint;
  groups:[KvGroupSpec];
  kv_dtype:string;
  model_dtype:string;
  attention_backend:string;
  quantization:string;
  rank:RankInfo;
  pipeline_depth:uint;
  encoder_cache_budget:uint;
  supported_controls:[ReqKind];
  adapter_mode:AdapterMode;
  execution_constraints:ExecutionConstraints;
  resource_classes:[ResourceClass];
  model_spec_digest:string;
  weight_digest:string;
  restored_sessions:[ulong];
}

table KvAllocation {
  block_ids:[uint];
  prefix_len:uint;
  group_id:uint;
}

table SequenceAdmission {
  sampling:SamplingParams;
  negative_token_ids:[uint];
  kv:KvAllocation;
}

table FlowAdmission { image:ImageParams; }

table Admission {
  session_id:ulong;
  digest:string;
  sequence:SequenceAdmission;
  flow:FlowAdmission;
  adapter_id:uint = null;
}

table KvLeaseDelta {
  group_id:uint;
  new_blocks:[uint];
}

table TokenPolicy {
  allowed_tokens:[uint];
  suppress_tokens:[uint];
  recent_tokens:[uint];
  publish_kv:bool;
  publish_kv_on_tokens:[uint];
}

table TokenInput {
  token_ids:[uint];
  source:TokenSource;
  draft_token_ids:[uint];
  burst_tokens:ushort = 1;
  stop_token_ids:[uint];
  stop_terminal:bool;
  return_all_logits:bool;
}

table PublishedLogits {
  handle:ulong;
  locator:string;
}

table PublishedKv {
  handle:ulong;
  locators:[string];
  source_version:ulong;
  kv_tokens:uint;
  block_ids:[uint];
  group_id:uint;
  position:uint;
}

union SequenceInput { TokenInput, PublishedLogits }

table SequenceOperation {
  mode:SequenceMode;
  lease:KvLeaseDelta;
  position_start:uint;
  position_end:uint;
  policy:TokenPolicy;
  input:SequenceInput;
}

table FlowOperation {
  latent_handle:ulong;
  position:uint;
  start_step:ushort;
  step_count:ushort = 1;
  conditioning_position:uint;
  conditioning:PublishedKv;
  guidance:Guidance;
  image_prompt:string;
}

table InlineImage {
  base64:string;
  content_hash:ulong;
}

table StagedProduct {
  handle:ulong;
  content_hash:ulong;
}

table CachedProduct { content_hash:ulong; }
union EncodeInput { InlineImage, StagedProduct, CachedProduct }

table EncodeOperation {
  kind:EncodeKind;
  lease:KvLeaseDelta;
  position_start:uint;
  position_end:uint;
  conditioning_position:uint;
  input:EncodeInput;
}

table LatentProduct { handle:ulong; }
table PublishedProduct { handle:ulong; locator:string; }
union MaterializeInput { LatentProduct, PublishedProduct }

table MaterializeOperation {
  kind:MaterializeKind;
  lease:KvLeaseDelta;
  position:uint;
  conditioning_position:uint;
  policy:TokenPolicy;
  input:MaterializeInput;
}

table TransferOperation {
  kind:TransferKind;
  lease:KvLeaseDelta;
  position:uint;
  conditioning_position:uint;
  policy:TokenPolicy;
  source:PublishedProduct;
}

union Operation {
  SequenceOperation,
  FlowOperation,
  EncodeOperation,
  MaterializeOperation,
  TransferOperation
}

table OperationEnvelope {
  session_id:ulong;
  epoch:ulong;
  op_id:ulong;
  base_version:ulong;
  digest:string;
  admission_digest:string;
  model_spec_digest:string;
  weight_digest:string;
  operation:Operation;
}

table SessionProjection {
  session_id:ulong;
  epoch:ulong;
  version:ulong;
  last_op_id:ulong;
  admission_digest:string;
  source_digest:string;
  last_sampled_token:uint = null;
}

table Batch {
  protocol_version:ushort;
  step_id:ulong;
  admissions:[Admission];
  projections:[SessionProjection];
  operations:[OperationEnvelope];
}

table SequenceEffect {
  sampled_token_ids:[uint];
  sampled_logprob:float = null;
  top_logprobs:[TokenLogprob];
  prompt_logprobs:[PositionLogprobs];
  accepted_draft_tokens:uint = null;
  kv_tokens:uint = null;
  published_logits:PublishedProduct;
  published_kv:PublishedKv;
}

table SequenceDelta { effect:SequenceEffect; }
table FlowDelta { steps_completed:ushort; done:bool; }
table EncodeDelta {
  product_handle:ulong;
  kv_tokens:uint;
  height:uint = null;
  width:uint = null;
}

table ImageArtifact {
  png_base64:string;
  height:uint;
  width:uint;
  handle:ulong;
  locator:string;
}

table FrameRecord { count:uint; }
union MaterializedProduct { ImageArtifact, PublishedProduct, FrameRecord }

table MaterializeDelta {
  product:MaterializedProduct;
  kv_tokens:uint = null;
  sequence:SequenceEffect;
}

table TransferDelta {
  product:PublishedProduct;
  kv_tokens:uint = null;
  sequence:SequenceEffect;
}

union ResultDelta {
  SequenceDelta,
  FlowDelta,
  EncodeDelta,
  MaterializeDelta,
  TransferDelta
}

table OperationResult {
  session_id:ulong;
  epoch:ulong;
  op_id:ulong;
  base_version:ulong;
  result_version:ulong;
  delta:ResultDelta;
}

table ExecutionResult {
  step_id:ulong;
  operations:[OperationResult];
  worker_exec_us:ulong = null;
  forward_stats:WorkerForwardStats;
}

table WorkerForwardStats {
  mode_counts:[StringU64Pair];
  mode_tokens:[StringU64Pair];
  mode_us:[StringU64Pair];
  attention_launches:ulong;
  attention_us:ulong;
  attention_backend_counts:[StringU64Pair];
  cuda_graph_captures:ulong;
  cuda_graph_replays:ulong;
  cuda_graph_misses:ulong;
  cuda_graph_fallbacks:ulong;
  cuda_graph_unpadded_tokens:ulong;
  cuda_graph_padded_tokens:ulong;
  cuda_graph_runtime_mode_counts:[StringU64Pair];
  text_decode_token_relay_hits:ulong;
  text_decode_token_relay_misses:ulong;
  text_decode_position_relay_hits:ulong;
  text_decode_position_relay_misses:ulong;
  flashinfer_decode_plan_calls:ulong;
  flashinfer_decode_plan_reuses:ulong;
  flashinfer_decode_plan_rows:ulong;
  flashinfer_decode_plan_indices:ulong;
  flashinfer_decode_graph_plan_calls:ulong;
  flashinfer_decode_graph_plan_reuses:ulong;
  spec_verify_rows:ulong;
  spec_verify_draft_tokens:ulong;
  spec_verify_accepted_tokens:ulong;
  spec_verify_rejected_tokens:ulong;
  spec_verify_committed_tokens:ulong;
  spec_verify_path_counts:[StringU64Pair];
  component_us:[StringU64Pair];
}

table WorkerMetrics {
  executes:ulong;
  operations_total:ulong;
  exec_us_total:ulong;
  last_exec_us:ulong;
  operation_counts:[StringU64Pair];
  operation_us:[StringU64Pair];
  control_ok:[StringU64Pair];
  control_err:[StringU64Pair];
  error_counts:[StringU64Pair];
  cuda_graph_captures:ulong;
  cuda_graph_replays:ulong;
  cuda_graph_misses:ulong;
  cuda_graph_fallbacks:ulong;
  cuda_graph_unpadded_tokens:ulong;
  cuda_graph_padded_tokens:ulong;
  cuda_graph_runtime_mode_counts:[StringU64Pair];
  forward:WorkerForwardStats;
}

table WorkerRequest {
  kind:ReqKind;
  call_id:ulong = null;
  batch:Batch;
  session_id:ulong = null;
  copies:[BlockPair];
  adapter_id:uint = null;
  adapter_path:string;
  product_handles:[ulong];
  snapshot:SnapshotRef;
}

table ErrorOperationIdentity {
  session_id:ulong;
  epoch:ulong;
  op_id:ulong;
}

table WorkerResponse {
  kind:RespKind;
  call_id:ulong = null;
  capabilities:EngineCaps;
  result:ExecutionResult;
  metrics:WorkerMetrics;
  pressure:[ResourcePressure];
  message:string;
  code:string;
  retryable:bool = null;
  fatal:bool = null;
  phase:string;
  route:string;
  operations:[ErrorOperationIdentity];
  snapshot:SnapshotRef;
}

root_type WorkerRequest;
