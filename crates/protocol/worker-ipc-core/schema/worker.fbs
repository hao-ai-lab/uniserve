namespace uniserve.wire;

// The closed leaves of the `Work` algebra. Every configured route runs one of
// these; the nesting (Token/Encode/Transfer/Gen) lives in the Rust and Python
// types and flattens to this exhaustive tag on the wire.
enum WorkVariant : ubyte {
  TokenExtend,
  TokenDecode,
  TokenVerify,
  Draft,
  EncodeVision,
  EncodeLatent,
  TransferProduct,
  TransferKvPublish,
  TransferKvInstall,
  GenTransition,
  GenFlow,
  Materialize
}

enum Domain : ubyte { Und, Gen }
enum ExecutionCapability : ubyte { DomainHomogeneous, TensorizedMixed }
enum AttentionRegime : ubyte { None, Causal, Bidirectional, Hybrid }
enum SamplingOwnership : ubyte { DesignatedRank, DeterministicSharded }

enum ProductKind : ubyte {
  Token,
  Logprob,
  Draft,
  VisionFeature,
  LatentFeature,
  Kv,
  Latent,
  Artifact,
  Completion,
  SamplingState,
  Finish,
  SelectedPoint,
  AcceptedSpan,
  Continuation
}

enum StorageClass : ubyte {
  DeviceTensor,
  PagedKv,
  LatentArena,
  HostStaging,
  CompletionArena
}

enum DType : ubyte { U8, U16, U32, I32, I64, F16, BF16, F32 }

enum OpStatus : ubyte { Ok, Predicated, Error }

enum ErrorCode : ubyte {
  InvalidOperation,
  ResourceExhausted,
  ComputeError,
  Cancelled,
  Internal
}

enum DrawLayout : ubyte { TargetSampling, SpeculativeProposal, FlowNoise }

enum Disposition : ubyte { Publish, Retain, Discard }

enum CloseReason : ubyte { Completed, Cancelled, Error, Preempted }

// Administrative worker command channel (separate from request `Control`).
enum ReqKind : ubyte {
  GetCapabilities,
  Execute,
  PollCompletions,
  DropSession,
  Shutdown,
  CopyKv,
  ReleaseProducts,
  GetMetrics,
  GetPressure,
  SnapshotSession,
  RestoreSession
}

enum RespKind : ubyte { Capabilities, Result, Ok, Error, Metrics, Pressure, Snapshot }
enum ResourceClass : ubyte { KvBlock, EncoderOutput, ImageLatent, Scratch }
enum KvGroupKind : ubyte { Full, SlidingWindow }

table U32List { items:[uint]; }
table TokenBias { token_id:uint; bias:float; }
table BlockPair { src:uint; dst:uint; }
table StringU64Pair { key:string; value:ulong; }

table SnapshotRef {
  version:VersionRef;
  digest:string;
  locator:string;
}

table SamplingParams {
  temperature:float;
  top_k:uint;
  top_p:float;
  ignore_eos:bool;
  seed:ulong = null;
  min_p:float;
  repetition_penalty:float = 1.0;
  frequency_penalty:float;
  presence_penalty:float;
  logit_bias:[TokenBias];
  min_tokens:ulong;
  n_logprobs:uint;
  bad_words_ids:[U32List];
  allowed_token_ids:[uint];
  return_logprobs:bool;
  return_prompt_logprobs:bool;
  n_prompt_logprobs:uint;
  logprob_token_ids:[uint];
  typical_p:float = 1.0;
  forced_token_ids:[uint];
}

table ImageParams {
  steps:ushort;
  cfg_text_scale:float;
  cfg_img_scale:float;
  cfg_renorm_type:string;
  cfg_renorm_min:float;
  cfg_interval_lo:float;
  cfg_interval_hi:float;
  timestep_shift:float = 1.0;
  height:uint;
  width:uint;
  seed:ulong = null;
  negative_prompt:string;
  max_images:ushort;
  image_prompts:[string];
  retain_images:bool = true;
}

table KvGroupSpec {
  group_id:uint;
  block_offset:uint;
  num_blocks:uint;
  kind:KvGroupKind;
  window:uint;
  sink:uint;
}

table RankInfo {
  tp_rank:uint;
  tp_size:uint = 1;
  pp_rank:uint;
  pp_size:uint = 1;
  dp_rank:uint;
  dp_size:uint = 1;
}

table ExecutionConstraints {
  max_batch_operations:uint;
  max_speculative_points:uint;
  max_unresolved_window:uint = 1;
  device_sequence_lengths:bool;
  device_append_offsets:bool;
  incremental_kv_publication:bool;
  route_capabilities:[RouteExecutionCapability];
}

table RouteExecutionCapability {
  route:uint;
  supported_work:[WorkVariant];
  tensorized_mixed:bool;
  sampling_ownership:SamplingOwnership;
  preemptible:bool;
  credits:RouteCreditLimits;
}

table CreditVector {
  registered_operations:ulong;
  execution_slots:ulong;
  completion_slots:ulong;
  device_products:ulong;
  kv_pages:ulong;
  rollback_deltas:ulong;
  latent_artifact_bytes:ulong;
  pinned_completion_staging_bytes:ulong;
  transfer_bytes:ulong;
  transfer_tickets:ulong;
  cpu_tasks:ulong;
  output_journal_bytes:ulong;
}

table RouteCreditLimits {
  per_request:CreditVector;
  worker:CreditVector;
}

table ResourcePressure {
  class:ResourceClass;
  total:ulong;
  used:ulong;
  evictable:ulong;
  free:ulong;
}

table EngineCaps {
  block_size:uint;
  num_blocks:uint;
  num_layers:uint;
  scratch_capacity_tokens:ulong;
  supported_work:[WorkVariant];
  max_latent_size:uint;
  latent_downsample:uint;
  bytes_per_token:ulong;
  max_vae_grid_tokens:uint;
  max_vit_grid_tokens:uint;
  max_latent_feature_bytes:ulong;
  max_vision_feature_bytes:ulong;
  commit_marker_tokens:uint;
  gen_rope_advance:uint;
  max_cfg_branches:uint;
  groups:[KvGroupSpec];
  kv_dtype:string;
  model_dtype:string;
  attention_backend:string;
  quantization:string;
  rank:RankInfo;
  pipeline_depth:uint;
  encoder_cache_budget:uint;
  supported_controls:[ReqKind];
  execution_constraints:ExecutionConstraints;
  resource_classes:[ResourceClass];
  model_spec_digest:string;
  weight_digest:string;
  protocol_layout_digest:string;
  route_capability_digest:string;
  restored_snapshots:[SnapshotRef];
}

// ---- Identities and the four protocol records -----------------------------

table RequestKey {
  authority_id:ulong;
  session_id:ulong;
  epoch:ulong;
}

table PointFixed {
  point_index:uint;
  semantic_digest:string;
}

table PointDevice {
  point_index:uint;
  selected_point:ProductRef;
  producer_plan_digest:string;
}

union Point { PointFixed, PointDevice }

table VersionRef {
  request_key:RequestKey;
  producer_op_id:ulong;
  point:Point;
}

// One dimension of a bounded shape: a host-static extent when `device` is
// false, or the fixed maximum of the single device-actual axis when true.
table DimBound {
  device:bool;
  value:uint;
}

table ShapeBound { dims:[DimBound]; }

table PointRange {
  base_point:uint;
  max_points:uint;
}

table ProductRef {
  request_key:RequestKey;
  producer_op_id:ulong;
  output_index:ushort;
  generation:uint;
  kind:ProductKind;
  storage_class:StorageClass;
  dtype:DType;
  shape_bound:ShapeBound;
  point_range:PointRange;
}

table Bounds {
  max_points:uint;
  max_tokens:uint;
  max_kv_pages:uint;
  max_latent_bytes:ulong;
  max_completion_bytes:ulong;
  max_transfer_bytes:ulong;
}

table Rng {
  seed:ulong;
  semantic_index_base:ulong;
  draw_layout:DrawLayout;
}

table Operation {
  request_key:RequestKey;
  op_id:ulong;
  parent:VersionRef;
  work:WorkVariant;
  route:uint;
  domain:Domain;
  advances_state:bool;
  bounds:Bounds;
  inputs:[ProductRef];
  outputs:[ProductRef];
  kv_capacity_pages:uint;
  predicate:ProductRef;
  rng:Rng;
  control_seq:ulong;
  plan_digest:string;
}

table KvReservation {
  request_key:RequestKey;
  op_id:ulong;
  logical_page_delta:[uint];
}

table LogicalLengths {
  token_len:uint;
  kv_visible_len:uint;
  latent_len:uint;
  kv_reserved_len:uint;
  kv_initialized_len:uint;
  kv_committed_len:uint;
  kv_published_len:uint;
}

table TokenSpan {
  base:uint;
  len:uint;
}

table FinishFlags {
  eos:bool;
  length:bool;
  stop:bool;
}

table TimingCounters {
  queued_us:ulong;
  device_us:ulong;
  copy_us:ulong;
  host_us:ulong;
}

table CompletionRecord {
  request_key:RequestKey;
  op_id:ulong;
  completion_slot_generation:uint;
  status:OpStatus;
  selected_point:uint;
  logical_lengths:LogicalLengths;
  token_span:TokenSpan;
  committed_tokens:[uint];
  finish_flags:FinishFlags;
  product_generations:[uint];
  semantic_digest:string;
  error_code:ErrorCode = null;
  timing_counters:TimingCounters;
}

table ControlCommit {
  request_key:RequestKey;
  control_seq:ulong;
  expected_parent:VersionRef;
  selected:VersionRef;
  public_event_limit:ulong;
  disposition:Disposition;
}

table ControlClose {
  request_key:RequestKey;
  control_seq:ulong;
  cutoff:VersionRef;
  reason:CloseReason;
}

table ControlRelease {
  request_key:RequestKey;
  op_id:ulong;
}

union Control { ControlCommit, ControlClose, ControlRelease }

table ControlEnvelope { control:Control; }

// ---- Admission framing (session establishment) ----------------------------

table KvAdmission {
  prefix_len:uint;
  group_id:uint;
}

table UndAdmission {
  sampling:SamplingParams;
  negative_token_ids:[uint];
  finish_token_ids:[uint];
  kv:KvAdmission;
}

table GenAdmission { image:ImageParams; }

table Admission {
  request_key:RequestKey;
  digest:string;
  und:UndAdmission;
  gen_admission:GenAdmission;
}

table BatchPartition {
  partition_id:uint;
  submission_group:uint;
  collective_seq:ulong;
  domain:Domain;
  route:uint;
  execution:ExecutionCapability;
  attention:AttentionRegime;
  shape_class:ulong;
  operations:[Operation];
  kv_reservations:[KvReservation];
}

table Batch {
  step_id:ulong;
  admissions:[Admission];
  partitions:[BatchPartition];
  controls:[ControlEnvelope];
  input_products:[ProductPayload];
}

// ---- Worker response payloads ---------------------------------------------

table RegistrationAck { visible:bool; }

// A resolved output-product value the worker delivers for host consumption:
// requested logprob blobs, materialized image bytes, and similar. Never a
// lineage identity, so it enters no semantic digest.
table ProductPayload {
  product:ProductRef;
  bytes:[ubyte];
}

table PartitionCompletion {
  partition_id:uint;
  completions:[CompletionRecord];
  products:[ProductPayload];
  registration:RegistrationAck;
  worker_exec_us:ulong = null;
  forward_stats:WorkerForwardStats;
}

table CompletionReport {
  step_id:ulong;
  partitions:[PartitionCompletion];
}

table WorkerForwardStats {
  mode_counts:[StringU64Pair];
  mode_tokens:[StringU64Pair];
  mode_us:[StringU64Pair];
  attention_launches:ulong;
  attention_us:ulong;
  attention_backend_counts:[StringU64Pair];
  cuda_graph_captures:ulong;
  cuda_graph_replays:ulong;
  cuda_graph_misses:ulong;
  cuda_graph_fallbacks:ulong;
  cuda_graph_unpadded_tokens:ulong;
  cuda_graph_padded_tokens:ulong;
  cuda_graph_runtime_mode_counts:[StringU64Pair];
  text_decode_token_relay_hits:ulong;
  text_decode_token_relay_misses:ulong;
  text_decode_position_relay_hits:ulong;
  text_decode_position_relay_misses:ulong;
  flashinfer_decode_plan_calls:ulong;
  flashinfer_decode_plan_reuses:ulong;
  flashinfer_decode_plan_rows:ulong;
  flashinfer_decode_plan_indices:ulong;
  flashinfer_decode_graph_plan_calls:ulong;
  flashinfer_decode_graph_plan_reuses:ulong;
  spec_verify_rows:ulong;
  spec_verify_draft_tokens:ulong;
  spec_verify_accepted_tokens:ulong;
  spec_verify_rejected_tokens:ulong;
  spec_verify_committed_tokens:ulong;
  spec_verify_path_counts:[StringU64Pair];
  component_us:[StringU64Pair];
}

table WorkerMetrics {
  executes:ulong;
  operations_total:ulong;
  exec_us_total:ulong;
  last_exec_us:ulong;
  operation_counts:[StringU64Pair];
  operation_us:[StringU64Pair];
  control_ok:[StringU64Pair];
  control_err:[StringU64Pair];
  error_counts:[StringU64Pair];
  cuda_graph_captures:ulong;
  cuda_graph_replays:ulong;
  cuda_graph_misses:ulong;
  cuda_graph_fallbacks:ulong;
  cuda_graph_unpadded_tokens:ulong;
  cuda_graph_padded_tokens:ulong;
  cuda_graph_runtime_mode_counts:[StringU64Pair];
  forward:WorkerForwardStats;
}

table WorkerRequest {
  kind:ReqKind;
  call_id:ulong = null;
  batch:Batch;
  step_id:ulong = null;
  session_id:ulong = null;
  copies:[BlockPair];
  product_handles:[ulong];
  snapshot:SnapshotRef;
}

table ErrorOperationIdentity {
  request_key:RequestKey;
  op_id:ulong;
}

table WorkerResponse {
  kind:RespKind;
  call_id:ulong = null;
  capabilities:EngineCaps;
  completion_report:CompletionReport;
  metrics:WorkerMetrics;
  pressure:[ResourcePressure];
  message:string;
  code:string;
  retryable:bool = null;
  fatal:bool = null;
  phase:string;
  route:string;
  operations:[ErrorOperationIdentity];
  snapshot:SnapshotRef;
}

root_type WorkerRequest;
