{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniServe serving benchmark summary",
  "type": "object",
  "required": [
    "harness_status",
    "task",
    "dataset",
    "request_count",
    "ok_count",
    "failed_count",
    "metric_family",
    "metrics",
    "load",
    "artifact"
  ],
  "properties": {
    "harness_status": {"type": "string"},
    "task": {"type": "string", "enum": ["text", "t2i", "i2i", "i2t", "default"]},
    "dataset": {"type": "string"},
    "endpoint": {"type": "string"},
    "model": {"type": "string"},
    "base_url": {"type": "string"},
    "server_info": {"type": ["object", "null"]},
    "spec": {"type": "object"},
    "load": {
      "type": "object",
      "required": ["mode", "request_rate", "num_prompts"],
      "properties": {
        "mode": {"type": "string", "enum": ["open_loop_poisson", "closed_loop", "saturation"]},
        "request_rate": {"type": ["number", "string"]},
        "max_concurrency": {"type": ["integer", "null"]},
        "warmup_requests": {"type": "integer"},
        "num_prompts": {"type": "integer"},
        "seed": {"type": "integer"}
      }
    },
    "elapsed_s": {"type": "number"},
    "request_count": {"type": "integer", "minimum": 0},
    "ok_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "classifiers": {"type": "object"},
    "metric_family": {"type": "string", "enum": ["stream", "image"]},
    "metrics": {"type": "object"},
    "artifact": {
      "type": "object",
      "required": ["schema_version", "valid", "valid_marker", "checks", "contract", "declared_contract", "plan_summary", "plan_evidence"],
      "properties": {
        "schema_version": {"type": "integer", "const": 2},
        "valid": {"type": "boolean"},
        "valid_marker": {"type": ["string", "null"]},
        "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
        "contract": {
          "type": "object",
          "required": ["schema_version", "spec", "selected_rows", "fingerprint"],
          "properties": {
            "schema_version": {"type": "integer", "const": 1},
            "spec": {"type": "object"},
            "selected_rows": {
              "type": "object",
              "required": ["count", "sha256"],
              "properties": {
                "count": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "declared_contract": {"type": "object"},
        "plan_summary": {"type": ["object", "null"]},
        "plan_evidence": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {"type": "string", "enum": ["declared_contract", "runtime_inspection", "reference_protocol"]},
            "plan": {"type": ["object", "null"]},
            "request": {"type": "object"},
            "endpoint": {"type": "string"},
            "error": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"source": {"const": "reference_protocol"}}},
              "then": {
                "anyOf": [
                  {"required": ["request"]},
                  {"required": ["plan", "error"]}
                ]
              },
              "else": {"required": ["plan"]}
            }
          ]
        },
        "profile_contract": {"$ref": "#/$defs/executionContract"},
        "matrix_contract": {"$ref": "#/$defs/executionContract"}
      }
    }
  },
  "$defs": {
    "executionContract": {
      "type": "object",
      "required": ["schema_version", "fingerprint"],
      "properties": {
        "schema_version": {"type": "integer", "const": 2},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
