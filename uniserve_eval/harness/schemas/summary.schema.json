{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniServe serving benchmark summary",
  "type": "object",
  "required": [
    "harness_status",
    "task",
    "dataset",
    "request_count",
    "ok_count",
    "failed_count",
    "warnings",
    "metric_family",
    "metrics",
    "load",
    "artifact"
  ],
  "properties": {
    "harness_status": {"type": "string"},
    "task": {"type": "string", "enum": ["text", "t2i", "i2i", "i2t", "interleave"]},
    "dataset": {"type": "string"},
    "endpoint": {"type": "string"},
    "model": {"type": "string"},
    "base_url": {"type": "string"},
    "server_info": {"type": ["object", "null"]},
    "spec": {"type": "object"},
    "load": {
      "type": "object",
      "required": ["mode", "request_rate", "num_prompts"],
      "properties": {
        "mode": {"type": "string", "enum": ["open_loop_poisson", "single_stream", "saturated_concurrency", "saturation"]},
        "request_rate": {"type": ["number", "string"]},
        "max_concurrency": {"type": ["integer", "null"]},
        "warmup_requests": {"type": "integer"},
        "num_prompts": {"type": "integer"},
        "seed": {"type": "integer"}
      }
    },
    "elapsed_s": {"type": "number"},
    "request_count": {"type": "integer", "minimum": 0},
    "ok_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "classifiers": {"type": "object"},
    "warnings": {"$ref": "#/$defs/warningSummary"},
    "metric_family": {"type": "string", "enum": ["stream", "image"]},
    "metrics": {"type": "object"},
    "artifact": {
      "type": "object",
      "required": ["schema_version", "valid", "valid_marker", "checks", "contract", "warnings", "image_samples"],
      "properties": {
        "schema_version": {"type": "integer", "const": 4},
        "valid": {"type": "boolean"},
        "valid_marker": {"type": ["string", "null"]},
        "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
        "contract": {
          "type": "object",
          "required": ["schema_version", "spec", "selected_rows", "fingerprint"],
          "properties": {
            "schema_version": {"type": "integer", "const": 1},
            "spec": {"type": "object"},
            "selected_rows": {
              "type": "object",
              "required": ["count", "sha256"],
              "properties": {
                "count": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "profile_contract": {"$ref": "#/$defs/executionContract"},
        "matrix_contract": {"$ref": "#/$defs/executionContract"},
        "execution_bundle_contract": {"$ref": "#/$defs/executionBundleContract"},
        "warnings": {"$ref": "#/$defs/warningSummary"},
        "image_samples": {"$ref": "#/$defs/imageSampleCollectionContract"}
      }
    }
  },
  "$defs": {
    "warningSummary": {
      "type": "object",
      "required": ["request_count", "total_count", "counts"],
      "properties": {
        "request_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      },
      "additionalProperties": false
    },
    "executionContract": {
      "type": "object",
      "required": ["schema_version", "fingerprint"],
      "properties": {
        "schema_version": {"type": "integer", "const": 2},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fileContentContract": {
      "type": "object",
      "required": ["size_bytes", "sha256"],
      "properties": {
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "imageSampleMetadata": {
      "type": "object",
      "required": ["sha256", "byte_size", "mime", "width", "height", "sample_filename"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1},
        "mime": {"type": "string", "pattern": "^image/"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sample_filename": {"type": "string", "pattern": "^[0-9a-f]{64}\\.[a-z0-9]+$"}
      },
      "additionalProperties": false
    },
    "imageSampleCollectionContract": {
      "type": "object",
      "required": ["schema_version", "reference_count", "file_count", "sha256", "files"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "reference_count": {"type": "integer", "minimum": 0},
        "file_count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/imageSampleMetadata"}}
      },
      "additionalProperties": false
    },
    "executionBundleContract": {
      "type": "object",
      "required": ["schema_version", "benchmark", "server_group", "point_files", "server_files", "fingerprint"],
      "properties": {
        "schema_version": {"type": "integer", "const": 2},
        "benchmark": {"type": "string", "minLength": 1},
        "server_group": {"type": "string", "minLength": 1},
        "point_files": {
          "type": "object",
          "required": ["command.txt", "preflight.txt", "postflight.txt", "run.json", "run.log"],
          "properties": {
            "command.txt": {"$ref": "#/$defs/fileContentContract"},
            "preflight.txt": {"$ref": "#/$defs/fileContentContract"},
            "postflight.txt": {"$ref": "#/$defs/fileContentContract"},
            "run.json": {"$ref": "#/$defs/fileContentContract"},
            "run.log": {"$ref": "#/$defs/fileContentContract"}
          },
          "additionalProperties": false
        },
        "server_files": {
          "type": "object",
          "required": ["server_command.txt", "server.log", "server.exit", "pre_server_snapshot.txt", "post_server_snapshot.txt"],
          "properties": {
            "server_command.txt": {"$ref": "#/$defs/fileContentContract"},
            "server.log": {"$ref": "#/$defs/fileContentContract"},
            "server.exit": {"$ref": "#/$defs/fileContentContract"},
            "pre_server_snapshot.txt": {"$ref": "#/$defs/fileContentContract"},
            "post_server_snapshot.txt": {"$ref": "#/$defs/fileContentContract"}
          },
          "additionalProperties": false
        },
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
