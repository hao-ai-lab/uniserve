  "workloads": {
    "gate/sensenova/t2i-seed42": {
      "type": "verify",
      "server": "gate/server/sensenova",
      "payload": {
        "model": "SenseNova-U1",
        "modalities": [
          "image"
        ],
        "messages": [
          {
            "role": "user",
            "content": "A red bicycle leaning against a weathered brick wall, golden hour light"
          }
        ],
        "image_config": {
          "width": 2048,
          "height": 1152,
          "steps": 50,
          "seed": 42
        }
      },
      "expect_images": 1,
      "expect_image_width": 2048,
      "expect_image_height": 1152,
      "expect_image_channel_dominance": [
        "red",
        "blue"
      ],
      "description": "SenseNova chat image correctness gate."
    },
    "gate/sensenova/i2t-house": {
      "type": "verify",
      "server": "gate/server/sensenova",
      "payload": {
        "model": "SenseNova-U1",
        "stream": true,
        "stream_options": {
          "include_usage": true
        },
        "modalities": [
          "text"
        ],
        "messages": [
          {
            "role": "user",
            "content": "Describe this image in detail."
          }
        ],
        "max_completion_tokens": 128,
        "temperature": 0
      },
      "input_image_synthetic": {
        "seed": 0,
        "width": 960,
        "height": 640
      },
      "expect_images": 0,
      "expect_min_text_tokens": 32,
      "description": "SenseNova image-to-text correctness gate."
    },
    "gate/sensenova/default-travel": {
      "type": "verify",
      "server": "gate/server/sensenova",
      "payload": {
        "model": "SenseNova-U1",
        "stream": true,
        "stream_options": {
          "include_usage": true
        },
        "modalities": [
          "text",
          "image"
        ],
        "messages": [
          {
            "role": "user",
            "content": "Generate a travel guide covering Sonoma, Sequoia, Tahoe, and the Golden Gate."
          }
        ],
        "max_completion_tokens": 4096,
        "temperature": 0,
        "image_config": {
          "width": 2048,
          "height": 1152,
          "steps": 50,
          "num_images": 4
        }
      },
      "expect_images": 4,
      "expect_image_steps": 200,
      "expect_image_width": 2048,
      "expect_image_height": 1152,
      "image_comparison": {
        "color_representation": "RGB uint8",
        "lpips": {
          "network": "alex",
          "input_size": [256, 256],
          "aggregation": "every image",
          "maximum": 0.15
        },
        "pixel_error": {
          "metric": "mean absolute error over full-resolution RGB uint8 values",
          "aggregation": "every image",
          "maximum": 12.0
        }
      },
      "timeout_s": 900,
      "description": "SenseNova default correctness gate."
    },
    "gate/bagel/t2i-seed42": {
      "type": "verify",
      "server": "gate/server/bagel",
      "payload": {
        "model": "BAGEL",
        "modalities": [
          "image"
        ],
        "messages": [
          {
            "role": "user",
            "content": "A red bicycle leaning against a weathered brick wall, golden hour light"
          }
        ],
        "image_config": {
          "width": 1024,
