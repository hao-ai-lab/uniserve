  "benchmarks": {
    "main": {
      "artifact_root": "artifacts/benchmark",
      "description": "Main benchmark matrix, expressed as open-loop arrival-rate points.",
      "hardware_requirements": {
        "gpu_count_per_process": 1,
        "gpu_model": "NVIDIA GB200"
      },
      "defaults": {
        "warmup_requests": 1,
        "seed": 42,
        "measurement_interface": "public_protocol_adapter",
        "cache_read_policy": "enabled",
        "cache_write_policy": "enabled",
        "adapter_selection": "base",
        "structured_output_policy": "none",
        "measured_runs": 1,
        "server_topology": "single_server_single_harness",
        "acceptance_min_success": 1,
        "acceptance_max_failed": 0
      },
      "load_cases": {
        "text_arrival": [
          {"id": "r1", "request_rate": 1},
          {"id": "r2", "request_rate": 2},
          {"id": "r4", "request_rate": 4},
          {"id": "r8", "request_rate": 8},
          {"id": "r16", "request_rate": 16}
        ],
        "image_concurrency": [
          {"id": "c1", "request_rate": "inf", "max_concurrency": 1},
          {"id": "c32", "request_rate": "inf", "max_concurrency": 32}
        ],
        "mixed_concurrency": [
          {
            "id": "image_light",
            "request_rate": "inf",
            "max_concurrency": 32,
            "harness": {
              "workload_mix": {"t2i": 8, "i2t": 24},
              "warmup_mix": {"t2i": 1, "i2t": 3},
              "acceptance_min_images_per_success": 0.25
            }
          },
          {
            "id": "balanced",
            "request_rate": "inf",
            "max_concurrency": 32,
            "harness": {
              "workload_mix": {"t2i": 16, "i2t": 16},
              "warmup_mix": {"t2i": 2, "i2t": 2},
              "acceptance_min_images_per_success": 0.5
            }
          },
          {
            "id": "image_heavy",
            "request_rate": "inf",
            "max_concurrency": 32,
            "harness": {
              "workload_mix": {"t2i": 24, "i2t": 8},
              "warmup_mix": {"t2i": 3, "i2t": 1},
              "acceptance_min_images_per_success": 0.75
            }
          }
        ]
      },
      "datasets": {
