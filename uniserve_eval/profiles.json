{
  "artifact_root": "artifacts/eval",
  "python": ".venv/bin/python",
  "server_bin": "target/release/uniserve",
  "shared": {
    "environment": {
      "UNISERVE_QWEN3_MODEL": "Path to Qwen3-32B",
      "UNISERVE_SENSENOVA_MODEL": "Path to SenseNova-U1 model directory",
      "UNISERVE_BAGEL_MODEL": "Path to BAGEL-7B-MoT",
      "UNISERVE_SHAREGPT_PATH": "Path to ShareGPT_V3_unfiltered_cleaned_split.json",
      "UNISERVE_SGLANG_PYTHON": "Python executable for refs/sglang",
      "UNISERVE_OMNI_VLLM": "vllm executable for vllm-omni"
    }
  },
  "servers": {
    "benchmark/server/_uniserve-mixed-base": {
      "host": "127.0.0.1",
      "cuda_visible_devices": "0",
      "env": {
        "UNISERVE_DECODE_TOKEN_BURST": "8"
      },
      "serve_args": [
        "--kv-token-capacity",
        "65536",
        "--max-num-seqs",
        "128",
        "--max-batch",
        "128",
        "--max-num-batched-tokens",
        "8192"
      ],
      "description": "Base UniServe benchmark server settings for mixed workloads.",
      "abstract": true
    },
    "gate/server/_uniserve-base": {
      "host": "127.0.0.1",
      "cuda_visible_devices": "0",
      "env": {
        "UNISERVE_DECODE_TOKEN_BURST": "8"
      },
      "serve_args": [
        "--kv-token-capacity",
        "65536",
        "--max-num-seqs",
        "1",
        "--max-batch",
        "4",
        "--max-num-batched-tokens",
        "4096"
      ],
      "description": "Base UniServe gate/tripwire server settings.",
      "abstract": true
    },
    "benchmark/server/qwen-uniserve": {
      "model": "${UNISERVE_QWEN3_MODEL}",
      "served_model_name": "Qwen3-32B",
      "host": "127.0.0.1",
      "port": 18081,
      "cuda_visible_devices": "0",
      "serve_args": [
        "--kv-token-capacity",
        "131072",
        "--max-num-seqs",
        "128",
        "--max-batch",
        "128",
        "--max-num-batched-tokens",
        "16384",
        "--long-prefill-threshold",
        "16384",
        "--prefill-cuda-graph",
        "true",
        "--prefill-cuda-graph-warmup",
        "true"
      ],
      "description": "UniServe Qwen3-32B benchmark server."
    },
    "benchmark/server/qwen-sglang": {
      "served_model_name": "Qwen3-32B",
      "host": "127.0.0.1",
      "port": 18080,
      "cuda_visible_devices": "0",
      "env": {
        "PYTHONPATH": "refs/sglang/python"
      },
      "command": [
        "${UNISERVE_SGLANG_PYTHON}",
        "-m",
        "sglang.launch_server",
        "--model-path",
        "${UNISERVE_QWEN3_MODEL}",
        "--served-model-name",
        "Qwen3-32B",
        "--host",
        "127.0.0.1",
        "--port",
        "18080",
        "--chunked-prefill-size",
        "16384",
        "--max-prefill-tokens",
        "16384",
        "--page-size",
        "64",
        "--reasoning-parser",
        "qwen3",
        "--trust-remote-code"
      ],
      "description": "SGLang Qwen3-32B benchmark server."
    },
    "benchmark/server/sensenova-uniserve": {
      "model": "${UNISERVE_SENSENOVA_MODEL}",
      "served_model_name": "SenseNova-U1",
      "port": 18082,
      "cuda_visible_devices": "0,1",
      "env": {
        "UNISERVE_DENOISE_STEP_GRAPH": "1"
      },
      "serve_args": [
        "--kv-token-capacity",
        "262144",
        "--max-num-seqs",
        "12",
        "--max-batch",
        "128",
        "--max-num-batched-tokens",
        "8192",
        "--worker-ranks",
        "2"
      ],
      "description": "UniServe SenseNova benchmark server (TP2, GPU0/GPU1). KV capacity 262144 tokens (~22GB/GPU) with max-num-seqs 12: the scheduler reserves each default request's full worst case (prompt + max_tokens + retained-image envelope) at admission, so concurrency scales with KV capacity and cannot deadlock. UNISERVE_DENOISE_STEP_GRAPH is on (validated safe under concurrency); the packed-mixed decoder graph was removed (segfaulted). Text-decode and image-denoise are never co-batched (scheduler default), which is required for correct mixed-output decode under load.",
      "extends": "benchmark/server/_uniserve-mixed-base",
      "abstract": false
    },
    "benchmark/server/sensenova-omni": {
      "served_model_name": "${UNISERVE_SENSENOVA_MODEL}",
      "host": "127.0.0.1",
      "port": 8091,
      "cuda_visible_devices": "0",
      "command": [
        "${UNISERVE_OMNI_VLLM}",
        "serve",
        "${UNISERVE_SENSENOVA_MODEL}",
        "--omni",
        "--host",
        "127.0.0.1",
        "--port",
        "8091"
      ],
      "description": "vllm-omni SenseNova benchmark server."
    },
    "benchmark/server/bagel-uniserve": {
      "model": "${UNISERVE_BAGEL_MODEL}",
      "served_model_name": "BAGEL",
      "port": 18083,
      "description": "UniServe BAGEL benchmark server.",
      "extends": "benchmark/server/_uniserve-mixed-base",
      "abstract": false
    },
    "benchmark/server/bagel-omni": {
      "served_model_name": "${UNISERVE_BAGEL_MODEL}",
      "host": "127.0.0.1",
      "port": 8092,
      "cuda_visible_devices": "0",
      "env": {
        "VLLM_OMNI_USE_QUACK_FP8": "0"
      },
      "command": [
        "${UNISERVE_OMNI_VLLM}",
        "serve",
        "${UNISERVE_BAGEL_MODEL}",
        "--omni",
        "--attention-config",
        "{\"backend\": \"TRITON_ATTN\"}",
        "--mm-encoder-attn-backend",
        "TORCH_SDPA",
        "--host",
        "127.0.0.1",
        "--port",
        "8092"
      ],
      "description": "vllm-omni BAGEL benchmark server."
    },
    "gate/server/sensenova": {
      "model": "${UNISERVE_SENSENOVA_MODEL}",
      "served_model_name": "SenseNova-U1",
      "port": 18082,
      "cuda_visible_devices": "0,1",
      "env": {
        "UNISERVE_DENOISE_STEP_GRAPH": "1"
      },
      "serve_args": [
        "--kv-token-capacity",
        "65536",
        "--max-num-seqs",
        "1",
        "--max-batch",
        "4",
        "--max-num-batched-tokens",
        "4096",
        "--worker-ranks",
        "2"
      ],
      "description": "UniServe SenseNova correctness/perf-tripwire server (single-user). UNISERVE_DENOISE_STEP_GRAPH stays on here where it is validated.",
      "extends": "gate/server/_uniserve-base",
      "abstract": false
    },
    "gate/server/bagel": {
      "model": "${UNISERVE_BAGEL_MODEL}",
      "served_model_name": "BAGEL",
      "port": 18083,
      "description": "UniServe BAGEL correctness/perf-tripwire server.",
      "extends": "gate/server/_uniserve-base",
      "abstract": false
    }
  },
  "workloads": {
    "gate/sensenova/t2i-seed42": {
      "type": "verify",
      "server": "gate/server/sensenova",
      "payload": {
        "constraint": "gen_only",
        "prompt": "A red bicycle leaning against a weathered brick wall, golden hour light",
        "seed": 42,
        "image": {
          "width": 2048,
          "height": 1152,
          "steps": 50
        }
      },
      "expect_images": 1,
      "expect_image_steps": 50,
      "expect_image_width": 2048,
      "expect_image_height": 1152,
      "description": "SenseNova native image correctness gate."
    },
    "gate/sensenova/i2t-house": {
      "type": "verify",
      "server": "gate/server/sensenova",
      "payload": {
        "constraint": "und_only",
        "prompt": "Describe this image in detail.",
        "max_tokens": 128,
        "temperature": 0
      },
      "input_image_synthetic": {
        "seed": 0,
        "width": 960,
        "height": 640
      },
      "expect_images": 0,
      "expect_min_text_tokens": 32,
      "description": "SenseNova image-to-text correctness gate."
    },
    "gate/sensenova/default-travel": {
      "type": "verify",
      "server": "gate/server/sensenova",
      "payload": {
        "constraint": "default",
        "prompt": "Generate a travel guide covering Sonoma, Sequoia, Tahoe, and the Golden Gate.",
        "max_tokens": 4096,
        "temperature": 0,
        "image": {
          "width": 2048,
          "height": 1152,
          "steps": 50,
          "max_images": 4,
          "retain_images": true
        }
      },
      "expect_images": 4,
      "expect_image_width": 2048,
      "expect_image_height": 1152,
      "expect_image_steps": 50,
      "timeout_s": 900,
      "description": "SenseNova default correctness gate."
    },
    "gate/bagel/t2i-seed42": {
      "type": "verify",
      "server": "gate/server/bagel",
      "payload": {
        "constraint": "gen_only",
        "prompt": "A red bicycle leaning against a weathered brick wall, golden hour light",
        "seed": 42,
        "image": {
          "width": 1024,
          "height": 1024,
          "steps": 50
        }
      },
      "expect_images": 1,
      "expect_image_steps": 50,
      "expect_image_width": 1024,
      "expect_image_height": 1024,
      "description": "BAGEL native image correctness gate."
    },
    "gate/bagel/i2t-house": {
      "type": "verify",
      "server": "gate/server/bagel",
      "payload": {
        "constraint": "und_only",
        "prompt": "Describe this image in detail.",
        "max_tokens": 128,
        "temperature": 0
      },
      "input_image_synthetic": {
        "seed": 0,
        "width": 960,
        "height": 640
      },
      "expect_images": 0,
      "expect_min_text_tokens": 32,
      "description": "BAGEL image-to-text correctness gate."
    },
    "perf/tripwire/sensenova/t2i": {
      "type": "perf",
      "server": "gate/server/sensenova",
      "task": "t2i",
      "args": [
        "--dataset",
        "trace",
        "--dataset-path",
        "uniserve_eval/data/t2i_prompts.jsonl",
        "--num-prompts",
        "4",
        "--request-rate",
        "1",
        "--warmup-requests",
        "1",
        "--steps",
        "50",
        "--seed",
        "42",
        "--width",
        "2048",
        "--height",
        "1152"
      ],
      "expect_metrics": {
        "image_latency_ms.mean": {
          "max": 8000
        }
      },
      "description": "SenseNova T2I perf tripwire at arrival rate 1."
    },
    "perf/tripwire/sensenova/i2t": {
      "type": "perf",
      "server": "gate/server/sensenova",
      "task": "i2t",
      "args": [
        "--dataset",
        "synthetic-images",
        "--num-prompts",
        "4",
        "--request-rate",
        "1",
        "--warmup-requests",
        "1",
        "--max-tokens",
        "256",
        "--temperature",
        "0",
        "--seed",
        "42",
        "--wire",
        "native"
      ],
      "expect_metrics": {
        "output_throughput": {
          "min": 120
        },
        "mean_itl_ms": {
          "max": 9
        }
      },
      "description": "SenseNova I2T perf tripwire at arrival rate 1."
    },
    "perf/tripwire/bagel/t2i": {
      "type": "perf",
      "server": "gate/server/bagel",
      "task": "t2i",
      "args": [
        "--dataset",
        "trace",
        "--dataset-path",
        "uniserve_eval/data/t2i_prompts.jsonl",
        "--num-prompts",
        "4",
        "--request-rate",
        "1",
        "--warmup-requests",
        "1",
        "--steps",
        "50",
        "--seed",
        "42",
        "--width",
        "1024",
        "--height",
        "1024"
      ],
      "expect_metrics": {
        "image_latency_ms.mean": {
          "max": 10000
        }
      },
      "description": "BAGEL T2I perf tripwire at arrival rate 1."
    },
    "perf/tripwire/bagel/i2t": {
      "type": "perf",
      "server": "gate/server/bagel",
      "task": "i2t",
      "args": [
        "--dataset",
        "synthetic-images",
        "--num-prompts",
        "4",
        "--request-rate",
        "1",
        "--warmup-requests",
        "1",
        "--max-tokens",
        "256",
        "--temperature",
        "0",
        "--seed",
        "42",
        "--wire",
        "native"
      ],
      "expect_metrics": {
        "output_throughput": {
          "min": 100
        },
        "mean_itl_ms": {
          "max": 9
        }
      },
      "description": "BAGEL I2T perf tripwire at arrival rate 1."
    }
  },
  "suites": {
    "gate/sensenova": [
      "gate/sensenova/t2i-seed42",
      "gate/sensenova/i2t-house",
      "gate/sensenova/default-travel"
    ],
    "gate/bagel": [
      "gate/bagel/t2i-seed42",
      "gate/bagel/i2t-house"
    ],
    "gate/all": [
      "gate/sensenova/t2i-seed42",
      "gate/sensenova/i2t-house",
      "gate/sensenova/default-travel",
      "gate/bagel/t2i-seed42",
      "gate/bagel/i2t-house"
    ],
    "perf/tripwire": [
      "perf/tripwire/sensenova/t2i",
      "perf/tripwire/sensenova/i2t",
      "perf/tripwire/bagel/t2i",
      "perf/tripwire/bagel/i2t"
    ]
  },
  "benchmarks": {
    "main": {
      "artifact_root": "artifacts/benchmarks",
      "description": "Main benchmark matrix, expressed as open-loop arrival-rate points.",
      "defaults": {
        "warmup_requests": 1,
        "seed": 42
      },
      "load_axes": {
        "arrival_rate": [
          "1",
          "2",
          "4",
          "8",
          "16"
        ]
      },
      "datasets": {
        "beans": {
          "type": "hf_image_sample",
          "name": "AI-Lab-Makerere/beans",
          "split": "train",
          "count": 200,
          "seed": 42,
          "output_dir": "datasets/i2t_beans",
          "prefix": "beans"
        }
      },
      "groups": {
        "qwen-uniserve": {
          "server": "benchmark/server/qwen-uniserve",
          "points": [
            "qwen3_sharegpt_uniserve"
          ]
        },
        "qwen-sglang": {
          "server": "benchmark/server/qwen-sglang",
          "points": [
            "qwen3_sharegpt_sglang"
          ]
        },
        "sensenova-uniserve": {
          "server": "benchmark/server/sensenova-uniserve",
          "points": [
            "sensenova_mjhq_t2i_uniserve",
            "sensenova_beans_i2t_uniserve",
            "sensenova_beans_i2t_chat_uniserve",
            "sensenova_ueval_default_uniserve",
            "sensenova_ueval_default_chat_uniserve"
          ]
        },
        "sensenova-omni": {
          "server": "benchmark/server/sensenova-omni",
          "points": [
            "sensenova_mjhq_t2i_omni",
            "sensenova_beans_i2t_omni"
          ]
        },
        "bagel-uniserve": {
          "server": "benchmark/server/bagel-uniserve",
          "points": [
            "bagel_mjhq_t2i_uniserve",
            "bagel_mjhq_t2i_chat_uniserve",
            "bagel_beans_i2t_uniserve",
            "bagel_beans_i2t_chat_uniserve"
          ]
        },
        "bagel-omni": {
          "server": "benchmark/server/bagel-omni",
          "points": [
            "bagel_mjhq_t2i_omni",
            "bagel_beans_i2t_omni"
          ]
        }
      },
      "points": {
        "qwen3_sharegpt_uniserve": {
          "axis": "arrival_rate",
          "name": "qwen-uniserve-sharegpt-r{rate_tag}",
          "output": "qwen3_sharegpt/uniserve_r{rate_tag}",
          "harness": {
            "task": "text",
            "model": "Qwen3-32B",
            "dataset": "sharegpt",
            "dataset_path": "${UNISERVE_SHAREGPT_PATH}",
            "tokenizer": "${UNISERVE_QWEN3_MODEL}",
            "num_prompts": 200
          }
        },
        "qwen3_sharegpt_sglang": {
          "axis": "arrival_rate",
          "name": "qwen-sglang-sharegpt-r{rate_tag}",
          "output": "qwen3_sharegpt/sglang_r{rate_tag}",
          "harness": {
            "task": "text",
            "model": "Qwen3-32B",
            "dataset": "sharegpt",
            "dataset_path": "${UNISERVE_SHAREGPT_PATH}",
            "tokenizer": "${UNISERVE_QWEN3_MODEL}",
            "num_prompts": 200
          }
        },
        "sensenova_mjhq_t2i_uniserve": {
          "axis": "arrival_rate",
          "name": "sensenova-uniserve-t2i-r{rate_tag}",
          "output": "sensenova_mjhq_t2i/uniserve_r{rate_tag}",
          "harness": {
            "task": "t2i",
            "model": "SenseNova-U1",
            "dataset": "mjhq",
            "num_prompts": 200,
            "steps": 50,
            "width": 2048,
            "height": 1152
          }
        },
        "sensenova_mjhq_t2i_omni": {
          "axis": "arrival_rate",
          "name": "sensenova-omni-t2i-r{rate_tag}",
          "output": "sensenova_mjhq_t2i/omni_r{rate_tag}",
          "harness": {
            "task": "t2i",
            "model": "${UNISERVE_SENSENOVA_MODEL}",
            "dataset": "mjhq",
            "num_prompts": 200,
            "steps": 50,
            "width": 2048,
            "height": 1152
          }
        },
        "sensenova_beans_i2t_uniserve": {
          "axis": "arrival_rate",
          "name": "sensenova-uniserve-i2t-r{rate_tag}",
          "output": "sensenova_beans_i2t/uniserve_r{rate_tag}",
          "harness": {
            "task": "i2t",
            "model": "SenseNova-U1",
            "dataset": "image-dir",
            "dataset_ref": "beans",
            "num_prompts": 200,
            "max_tokens": 256,
            "temperature": 0,
            "wire": "native"
          }
        },
        "sensenova_beans_i2t_omni": {
          "axis": "arrival_rate",
          "name": "sensenova-omni-i2t-r{rate_tag}",
          "output": "sensenova_beans_i2t/omni_r{rate_tag}",
          "harness": {
            "task": "i2t",
            "model": "${UNISERVE_SENSENOVA_MODEL}",
            "dataset": "image-dir",
            "dataset_ref": "beans",
            "num_prompts": 200,
            "max_tokens": 256,
            "temperature": 0,
            "wire": "openai_chat_json"
          }
        },
        "sensenova_ueval_default_uniserve": {
          "axis": "arrival_rate",
          "name": "sensenova-uniserve-ueval-r{rate_tag}",
          "output": "sensenova_ueval_default/uniserve_r{rate_tag}",
          "harness": {
            "task": "default",
            "model": "SenseNova-U1",
            "dataset": "ueval",
            "num_prompts": 32,
            "max_tokens": 8192,
            "steps": 50,
            "width": 2048,
            "height": 1152,
            "temperature": 0.7
          }
        },
        "sensenova_ueval_default_chat_uniserve": {
          "axis": "arrival_rate",
          "name": "sensenova-uniserve-ueval-chat-r{rate_tag}",
          "output": "sensenova_ueval_default/uniserve_chat_r{rate_tag}",
          "harness": {
            "task": "default",
            "model": "SenseNova-U1",
            "dataset": "ueval",
            "num_prompts": 32,
            "max_tokens": 8192,
            "steps": 50,
            "width": 2048,
            "height": 1152,
            "wire": "openai_chat",
            "temperature": 0.7
          }
        },
        "bagel_mjhq_t2i_uniserve": {
          "axis": "arrival_rate",
          "name": "bagel-uniserve-t2i-r{rate_tag}",
          "output": "bagel_mjhq_t2i/uniserve_r{rate_tag}",
          "harness": {
            "task": "t2i",
            "model": "BAGEL",
            "dataset": "mjhq",
            "num_prompts": 200,
            "steps": 50,
            "width": 1024,
            "height": 1024
          }
        },
        "bagel_mjhq_t2i_omni": {
          "axis": "arrival_rate",
          "name": "bagel-omni-t2i-r{rate_tag}",
          "output": "bagel_mjhq_t2i/omni_r{rate_tag}",
          "harness": {
            "task": "t2i",
            "model": "${UNISERVE_BAGEL_MODEL}",
            "dataset": "mjhq",
            "num_prompts": 200,
            "steps": 50,
            "width": 1024,
            "height": 1024
          }
        },
        "bagel_beans_i2t_uniserve": {
          "axis": "arrival_rate",
          "name": "bagel-uniserve-i2t-r{rate_tag}",
          "output": "bagel_beans_i2t/uniserve_r{rate_tag}",
          "harness": {
            "task": "i2t",
            "model": "BAGEL",
            "dataset": "image-dir",
            "dataset_ref": "beans",
            "num_prompts": 200,
            "max_tokens": 256,
            "temperature": 0,
            "wire": "native"
          }
        },
        "bagel_beans_i2t_omni": {
          "axis": "arrival_rate",
          "name": "bagel-omni-i2t-r{rate_tag}",
          "output": "bagel_beans_i2t/omni_r{rate_tag}",
          "harness": {
            "task": "i2t",
            "model": "${UNISERVE_BAGEL_MODEL}",
            "dataset": "image-dir",
            "dataset_ref": "beans",
            "num_prompts": 200,
            "max_tokens": 256,
            "temperature": 0,
            "wire": "openai_chat_json"
          }
        },
        "sensenova_beans_i2t_chat_uniserve": {
          "axis": "arrival_rate",
          "name": "sensenova-uniserve-i2t-chat-r{rate_tag}",
          "output": "sensenova_beans_i2t/uniserve_chat_r{rate_tag}",
          "harness": {
            "task": "i2t",
            "model": "SenseNova-U1",
            "dataset": "image-dir",
            "dataset_ref": "beans",
            "num_prompts": 200,
            "max_tokens": 256,
            "temperature": 0,
            "wire": "openai_chat"
          }
        },
        "bagel_beans_i2t_chat_uniserve": {
          "axis": "arrival_rate",
          "name": "bagel-uniserve-i2t-chat-r{rate_tag}",
